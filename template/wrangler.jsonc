// Static assets only. The Custom Domain (routes) is added at launch.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "exp-template",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  // Served only on its own subdomain: no <name>.<account>.workers.dev
  // address, and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
}
