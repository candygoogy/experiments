{
  "name": "experiments",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared",
    "template",
    "battery",
    "keyboard",
    "photo",
    "compose",
    "logscope",
    "mail",
    "subnet"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && playwright test",
    "build": "npm run build --workspaces --if-present",
    "new": "node scripts/new.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
