// Static assets only, served on its own subdomain (a Custom Domain).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "exp-logscope",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "logscope.candygoogy.dev", "custom_domain": true }],
  // Served only at its own domain: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // A path with no file gets dist/404.html, with a 404 status.
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
}
