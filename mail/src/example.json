  "shop.example TXT": {
    "Status": 0,
    "AD": true,
    "Answer": [
      {
        "type": 16,
        "data": "\"v=spf1 include:_spf.mailhost.example ~all\""
      },
      {
        "type": 16,
        "data": "\"example-site-verification=made-up\""
      }
    ]
  },
  "_spf.mailhost.example TXT": {
    "Status": 0,
    "AD": true,
    "Answer": [
      {
        "type": 16,
        "data": "\"v=spf1 ip4:192.0.2.0/24 ip4:198.51.100.0/24 -all\""
      }
    ]
  },
