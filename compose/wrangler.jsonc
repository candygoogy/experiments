// Static assets only, served on its own subdomain (a Custom Domain).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "exp-compose",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "compose.candygoogy.dev", "custom_domain": true }],
  "assets": { "directory": "./dist" },
  // Served only on its own subdomain: no <name>.<account>.workers.dev
  // address, and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
}
